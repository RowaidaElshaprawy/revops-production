# Copy to .env and fill in for production. Never commit the real .env file.

# Leave sqlite default for dev. For real production, point at Postgres:
# DATABASE_URL=postgresql://user:password@host:5432/revops
DATABASE_URL=sqlite:///./data/revops.db

# Set a real secret before deploying publicly. Empty = auth disabled (dev only).
REVOPS_API_KEY=

ENVIRONMENT=production
LOG_LEVEL=INFO
